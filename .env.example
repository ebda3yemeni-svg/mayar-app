# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WEBRTC STUN & TURN CONFIGURATION
STUN_SERVER_URL="stun:stun.l.google.com:19302"
TURN_SERVER_URL="turn:turn.mayar.app:3478"
TURN_USERNAME="mayar_user"
TURN_CREDENTIAL="mayar_secret_key"

# FIREBASE CONFIGURATION (For Mobile Android & Cloud Firestore Push)
FIREBASE_PROJECT_ID="mayar-app-prod"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@mayar-app-prod.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_STORAGE_BUCKET="mayar-app-prod.appspot.com"

# SIGNALING SERVER & JWT
PORT=3000
JWT_SECRET="mayar_super_secret_jwt_key_2026"

